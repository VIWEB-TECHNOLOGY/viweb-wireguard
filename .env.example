# Non-sensitive settings only. Never put passwords or keys here.

# Public WireGuard UDP port (host and container side are kept identical).
# If you change it, enter the same port during onboarding and check
# Admin Panel > Interface > Port and Admin Panel > Config > Port.
WG_PORT=51820

# Web UI port on 127.0.0.1 of the Docker host (loopback only).
WG_UI_PORT=51821

# Docker bridge subnets for the container. Change only if they clash with
# existing networks on the host. These are NOT the VPN client subnets
# (those are set in Admin Panel > Interface).
WG_DOCKER_IPV4_SUBNET=10.42.42.0/24
WG_DOCKER_IPV6_SUBNET=fdcc:ad94:bacf:61a3::/64
